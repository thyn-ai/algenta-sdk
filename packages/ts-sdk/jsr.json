{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@algenta/sdk",
  "version": "1.0.17",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/client.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "exclude": [
      "src/**/*.test.ts",
      "src/**/*_test_helpers*.ts",
      "src/**/test_contract_helpers.ts"
    ]
  }
}
