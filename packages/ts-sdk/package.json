{
  "name": "algenta-sdk",
  "version": "1.0.23",
  "description": "TypeScript and JavaScript SDK for Algenta — self-hosted building blocks for AI applications: the HTTP API, local runtime, simulations, governed data, and repository intelligence",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "proto",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "test": "tsc && vitest run",
    "test:coverage": "tsc && vitest run --coverage",
    "lint": "tsc --noEmit",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check --write ."
  },
  "keywords": [
    "algenta",
    "typescript",
    "decision",
    "runtime",
    "simulation",
    "monte-carlo",
    "governed-data",
    "repository-intelligence",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "agent-governance",
    "mojo",
    "receipts",
    "approvals"
  ],
  "homepage": "https://docs.algenta.ai/sdks/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thyn-ai/algenta-sdk.git",
    "directory": "packages/ts-sdk"
  },
  "bugs": {
    "url": "https://github.com/thyn-ai/algenta-sdk/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "4.10.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "protobufjs": "^7.6.5",
    "qs": "^6.16.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
