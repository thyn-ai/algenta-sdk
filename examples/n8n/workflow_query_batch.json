{
  "name": "Algenta — Discover Dataset and Query Batch",
  "nodes": [
    {
      "parameters": {},
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://your-algenta-base-url.example/openapi.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-contract",
      "name": "Get Contract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 140],
      "credentials": {
        "httpHeaderAuth": {
          "id": "algenta-api-key",
          "name": "Algenta API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ \"https://your-algenta-base-url.example\" + $node[\"Get Contract\"].json[\"x-primary-data-query-contract\"][\"api\"][\"discovery_endpoint\"] + \"?search=orders&compact=1&limit=5\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "discover-datasets",
      "name": "Discover Datasets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "algenta-api-key",
          "name": "Algenta API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ \"https://your-algenta-base-url.example\" + $node[\"Get Contract\"].json[\"x-primary-data-query-contract\"][\"api\"][\"summary_endpoint\"].replace(\"{dataset_id}\", $json[\"datasets\"][0][\"dataset_id\"]) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-summary",
      "name": "Get Dataset Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [680, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "algenta-api-key",
          "name": "Algenta API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \"https://your-algenta-base-url.example\" + $node[\"Get Contract\"].json[\"x-primary-data-query-contract\"][\"api\"][\"query_batch_endpoint\"] }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ JSON.stringify({ defaults: { dataset_id: $json[\"dataset_id\"], filter: { time_filter: \"last_year\", conditions: [{ dimension_hint: \"status\", op: \"eq\", value: \"completed\" }] } }, queries: [ { key: \"completed_orders\", request: { metric: { role: \"metric\", hint: \"order_count\" }, aggregation: \"sum\" } }, { key: \"monthly_completed_orders\", request: { metric: { role: \"metric\", hint: \"order_count\" }, aggregation: \"sum\", group_by: [\"order_month\"], limit: 12, order: \"desc\" } } ] }) }}",
        "options": {}
      },
      "id": "query-batch",
      "name": "Query Batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [920, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "algenta-api-key",
          "name": "Algenta API Key"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "contract_endpoint",
              "value": "={{$node[\"Get Contract\"].json[\"x-primary-data-query-contract\"][\"api\"][\"contract_endpoint\"] || \"\"}}"
            },
            {
              "name": "dataset_id",
              "value": "={{$node[\"Get Dataset Summary\"].json[\"dataset_id\"] || \"\"}}"
            },
            {
              "name": "request_id",
              "value": "={{$json[\"request_id\"]}}"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-response",
      "name": "Extract Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1160, 300]
    }
  ],
  "connections": {
    "Start": {
      "main": [[{"node": "Get Contract", "type": "main", "index": 0}]]
    },
    "Get Contract": {
      "main": [[{"node": "Discover Datasets", "type": "main", "index": 0}]]
    },
    "Discover Datasets": {
      "main": [[{"node": "Get Dataset Summary", "type": "main", "index": 0}]]
    },
    "Get Dataset Summary": {
      "main": [[{"node": "Query Batch", "type": "main", "index": 0}]]
    },
    "Query Batch": {
      "main": [[{"node": "Extract Response", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "instanceId": "algenta-query-batch-example"
  },
  "_comment": "Import this workflow into n8n. Replace https://your-algenta-base-url.example with Cloud Managed https://api.algenta.ai or your self-hosted base URL before enabling the workflow. Set credentials: HTTP Header Auth with name 'Authorization' and value 'Bearer <YOUR_ALGENTA_API_KEY>'. It inspects /openapi.json, extracts x-primary-data-query-contract, then discovers datasets, fetches one low-token summary, and runs /v1/query/batch. That keeps the workflow compatible with older self-hosted nodes that still return 404 for /v1/meta/contract. Private profiles do not silently fall back to Algenta cloud."
}
